rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User private profile
    match /users/{userId}/profile/info {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() <= 120;
      allow delete: if isOwner(userId);
    }

    // User courses subcollection
    match /users/{userId}/courses/{courseId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(courseId)
        && request.resource.data.userId == userId
        && request.resource.data.code is string
        && request.resource.data.title is string;
      allow update: if isOwner(userId)
        && isValidId(courseId)
        && request.resource.data.userId == userId
        && resource.data.userId == userId;
      allow delete: if isOwner(userId);
    }

    // User lessons subcollection
    match /users/{userId}/lessons/{lessonId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(lessonId)
        && request.resource.data.userId == userId
        && request.resource.data.title is string;
      allow update: if isOwner(userId)
        && isValidId(lessonId)
        && request.resource.data.userId == userId
        && resource.data.userId == userId;
      allow delete: if isOwner(userId);
    }

    // User study plans subcollection
    match /users/{userId}/studyPlans/{planId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(planId)
        && request.resource.data.userId == userId;
      allow update: if isOwner(userId)
        && isValidId(planId)
        && request.resource.data.userId == userId
        && resource.data.userId == userId;
      allow delete: if isOwner(userId);
    }

    // User assignments subcollection
    match /users/{userId}/assignments/{assignmentId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(assignmentId)
        && request.resource.data.userId == userId
        && request.resource.data.title is string;
      allow update: if isOwner(userId)
        && isValidId(assignmentId)
        && request.resource.data.userId == userId
        && resource.data.userId == userId;
      allow delete: if isOwner(userId);
    }
  }
}
